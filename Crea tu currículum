<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Generador de CV</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <style>
    body { font-family: 'Roboto', sans-serif; background: #f4f4f4; }
    .cv-container { width: 800px; margin: auto; padding: 20px; background: #fff; }
    .cv-header { text-align: center; border-bottom: 2px solid #004080; }
    .cv-photo { width: 100px; border-radius: 50%; border: 3px solid #004080; }
    .cv-section { margin: 20px 0; }
    /* Estilos alternativos */
    .clasico { font-family: 'Merriweather', serif; color: #000; }
    .moderno { font-family: 'Roboto', sans-serif; color: #004080; }
    .creativo { font-family: 'Poppins', sans-serif; color: #d35400; }
  </style>
</head>
<body>
  <div id="cv" class="cv-container clasico">
    <div class="cv-header">
      <img src="foto.jpg" alt="Foto" class="cv-photo"/>
      <h1>Jorge Alfonso Nauta Siguencia</h1>
      <p>Correo: alfonso.nauta@educacion.gob.ec</p>
      <p>Teléfono: 4044064</p>
    </div>
    <div class="cv-section">
      <h2>Formación Académica</h2>
      <ul>
        <li>Primaria: Escuela Vicente Rocafuerte</li>
        <li>Secundaria: Colegio Andrés F. Córdova</li>
        <li>Universidad: Universidad de Cuenca</li>
        <li>Posgrado: Universidad Católica de Cuenca</li>
      </ul>
    </div>
  </div>

  <select id="plantilla">
    <option value="clasico">Clásico</option>
    <option value="moderno">Moderno</option>
    <option value="creativo">Creativo</option>
  </select>
  <button onclick="cambiarEstilo()">Cambiar Estilo</button>
  <button onclick="descargarPDF()">Exportar PDF</button>

  <script>
    function cambiarEstilo() {
      const cv = document.getElementById("cv");
      const estilo = document.getElementById("plantilla").value;
      cv.className = "cv-container " + estilo;
    }

    async function descargarPDF() {
      const { jsPDF } = window.jspdf;
      const cv = document.getElementById("cv");
      const canvas = await html2canvas(cv);
      const imgData = canvas.toDataURL("image/png");

      const pdf = new jsPDF("p", "mm", "a4");
      const imgProps = pdf.getImageProperties(imgData);
      const pdfWidth = pdf.internal.pageSize.getWidth();
      const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

      pdf.addImage(imgData, "PNG", 0, 0, pdfWidth, pdfHeight);
      pdf.save("Curriculum_Jorge.pdf");
    }
  </script>
</body>
</html>
